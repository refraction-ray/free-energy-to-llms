# Whitelist: only the paths listed below are published. Everything else in the
# working directory (notes, drafts, deprecated material, build output) stays local.
/*
!/.gitignore
!/.github/
!/LICENSE
!/Makefile
!/README.md
!/README.en.md
!/book/
!/figures/
!/docs/
!/slides/

# LaTeX by-products, in case something is compiled in place
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.synctex(busy)
*.toc
*.vrb
*.xdv
.DS_Store
